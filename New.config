#### Default values for epay_transaction_service#
replicaCount: 1
##

image:
  repository: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/app/backend/epay_transaction_service

  pullPolicy: IfNotPresent
  tag: "1.20.0"

# env:
#   - name: JAVA_TOOL_OPTIONS. 
#     value: "-Xms512m -Xmx1024m"
sidecar:
  istio:
    rewriteAppHTTPProbers: true
    
imagePullSecrets: 
  - name: jfrog-pull-secret

nameOverride: ""
fullnameOverride: ""

serviceAccount:
  create: true
  automount: true
  annotations: {}
  name: ""
podAnnotations: {}
podLabels: {}
podSecurityContext: {}
securityContext: {}

service:
  type: ClusterIP
  port: 9092

configMap: 
  additionalLabels: {}
  annotations: {}
  nameSuffix: "config"
  data: true

# namespace: prod-dr-transaction
# gatewayName: prod-istio-system/prod-gateway
# virtualServiceName: txn-transactionservice
# serviceName: txn-transactionservice
# prefixName: /api/transaction/v1
# servicePort: 9092
# gatewayPort: 80
# gatewayHost: "sbiepay.sbi.bank.in"



namespace: prod-dr-transaction
gatewayName: prod-dr-istio-system/prod-dr-istio-gateway
virtualServiceName: txn-transactionservice
serviceName: txn-transactionservice
prefixName: /api/transaction/v1
servicePort: 9092
gatewayPort: 80
gatewayHost: "sbiepay.sbi.bank.in"
routes:
  - prefixName: /api/transaction/v1/token/access
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/order/status
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/order/create
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/customer/create
    serviceName: txn-transactionservice
    servicePort: 9092 
  - prefixName: /api/transaction/v1/customer/
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/refund/search
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/refund/book
    serviceName: txn-transactionservice
    servicePort: 9092 
  - prefixName: /api/transaction/v1/token/txn
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/booking
    serviceName: txn-transactionservice
    servicePort: 9092 
  - prefixName: /api/transaction/v1/callback
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/pricing
    serviceName: txn-transactionservice
    servicePort: 9092 
  - prefixName: /api/transaction/v1/upi/sbi/validate-vpa
    serviceName: txn-transactionservice
    servicePort: 9092   
  - prefixName: /api/transaction/v1/upi/sbi/txn/status
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/token/txn/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/token/invalidate
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/token/access/validate
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/search
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/search/download
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/bulk-upload/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/bulk-download/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/book
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/book
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/refund/merchant/bulk-details/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/payment/update-fail
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/payment/update-cancel
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/payment/search
    serviceName: txn-transactionservice
    servicePort: 9092
  # - prefixName: /api/transaction/v1/order/update-status
  #   serviceName: txn-transactionservice
  #   servicePort: 9092
  - prefixName: /api/transaction/v1/order/search/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/order/download/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/order/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/initiate-payment/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/eis/validate-gstn
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/eis/validate-ecom
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/customer/
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/cards/sbi/rupay/verify-otp
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/cards/sbi/rupay/resend-otp
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/card/sbi/validate-bin
    serviceName: txn-transactionservice
    servicePort: 9092
  - prefixName: /api/transaction/v1/booking/
    serviceName: txn-transactionservice
    servicePort: 9092  
  - prefixName: /api/transaction/v1/mis/report
    serviceName: txn-transactionservice
    servicePort: 9092




resources:
  requests:
    memory: "3Gi"
    cpu: "2000m"
  limits:
    memory: "4Gi"
    cpu: "3000m"
ingress: {}

jvm:
  opts: "-XX:+UseG1GC -XX:+AlwaysPreTouch -XX:MaxRAMPercentage=80.0"

# Enable health probes for proper HPA functioning
readinessProbe:
  enabled: false
  httpGet:
    path: "/api/transaction/v1/actuator/health/readiness"
    port: 9092
    scheme: HTTP
  initialDelaySeconds: 60
  periodSeconds: 10

livenessProbe:
  enabled: false
  httpGet:
    path: "/api/transaction/v1/actuator/health/liveness"
    port: 9092
    scheme: HTTP
  initialDelaySeconds: 30
  periodSeconds: 10

# HPA Configuration
hpa:
  enabled: true
  minReplicas: 4
  maxReplicas: 20
  targetCPUUtilizationPercentage: 70
  targetMemoryUtilizationPercentage: 80
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 60
      policies:
      - type: Percent
        value: 50
        periodSeconds: 60
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
      - type: Percent
        value: 10
        periodSeconds: 60

autoscaling:
  enabled: true

# Mount application.properties configmap
volumes:
  - name: config
    configMap:
      name: txn-config
  # - name: gemfire-transaction-cert
  #   secret:
  #     secretName: gemfire-prod-cert-transaction
  #     defaultMode: 420
      
volumeMounts:
  - name: config
    mountPath: "/opt/gradle"
    readOnly: true
  # - name: gemfire-transaction-cert
  #   readOnly: true
  #   mountPath: /certs
nodeSelector: {}
tolerations: []
affinity: {}
#
