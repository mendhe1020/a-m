stages:
  - config-deploy
  - restart

variables:
  DEV_CLUSTER: "https://api.dev.sbiepay.sbi:6443"

.fetch_services_config:
  before_script:
    - git config --global http.sslVerify false
    - git clone --depth 1 "https://oauth2:${GITLAB_CI_DEPLOY_TOKEN}@gitlab.sbi/itepaypg-sbiepay2/infra/devops/cicd-templates.git" templates-repo
    - |
      sed -n '/SERVICES_CONFIG:/,$p' templates-repo/config/services.yaml | tail -n +2 > /tmp/services.yml

deploy-config:
  stage: config-deploy
  image: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/custom-ci/rhelgit-oc-helm:1.0
  tags:
    - deploy_runner
  when: manual
  extends: .fetch_services_config
  rules:
    - if: '$CI_COMMIT_BRANCH == "dev"'
      changes:
        - "*/*/application.yml"
  script:
    - |
      set -eo pipefail
      CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -E '^[^/]+/[^/]+/application\.yml$' || true)

      if [ -z "$CHANGED_FILES" ]; then
        echo "No application.yml changes detected"
        exit 0
      fi

      oc login "$DEV_CLUSTER" --token="$OCP_TOKEN_DEV_CLUSTER" --insecure-skip-tls-verify

      while IFS= read -r CONFIG_FILE; do
        SERVICE_NAME=$(echo "$CONFIG_FILE" | cut -d'/' -f1)
        ENV=$(echo "$CONFIG_FILE" | cut -d'/' -f2)

        NAMESPACE=$(awk -v svc="$SERVICE_NAME" '
          /namespace:/ {ns=$3}
          $0 ~ "name: "svc {print ns; exit}
        ' /tmp/services.yml)
        NAMESPACE="${ENV}-${NAMESPACE}"

        RELEASE_NAME=$(awk -v svc="$SERVICE_NAME" '
          $0 ~ "name: "svc {found=1}
          found && /release:/ {print $2; exit}
        ' /tmp/services.yml)
        RELEASE_NAME=${RELEASE_NAME:-$(echo "$SERVICE_NAME" | tr '_' '-')}

        CONFIGMAP_NAME="${RELEASE_NAME}-config"

        echo "▶ SERVICE_NAME=$SERVICE_NAME | ENV=$ENV | NAMESPACE=$NAMESPACE | CONFIGMAP=$CONFIGMAP_NAME"

        oc create configmap "$CONFIGMAP_NAME" --from-file=application.yml="$CONFIG_FILE" -n "$NAMESPACE" --dry-run=client -o yaml | oc apply -f -
        echo "✅ $CONFIGMAP_NAME updated in $NAMESPACE"
      done <<< "$CHANGED_FILES"

restart-service:
  stage: restart
  image: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/custom-ci/rhelgit-oc-helm:1.0
  tags:
    - deploy_runner
  when: manual
  extends: .fetch_services_config
  needs:
    - job: deploy-config
  rules:
    - if: '$CI_COMMIT_BRANCH == "dev"'
      changes:
        - "*/*/application.yml"
  script:
    - |
      set -eo pipefail
      CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -E '^[^/]+/[^/]+/application\.yml$' || true)

      if [ -z "$CHANGED_FILES" ]; then
        echo "No application.yml changes detected"
        exit 0
      fi

      oc login "$DEV_CLUSTER" --token="$OCP_TOKEN_DEV_CLUSTER" --insecure-skip-tls-verify

      while IFS= read -r CONFIG_FILE; do
        SERVICE_NAME=$(echo "$CONFIG_FILE" | cut -d'/' -f1)
        ENV=$(echo "$CONFIG_FILE" | cut -d'/' -f2)

        NAMESPACE=$(awk -v svc="$SERVICE_NAME" '
          /namespace:/ {ns=$3}
          $0 ~ "name: "svc {print ns; exit}
        ' /tmp/services.yml)
        NAMESPACE="${ENV}-${NAMESPACE}"

        RELEASE_NAME=$(awk -v svc="$SERVICE_NAME" '
          $0 ~ "name: "svc {found=1}
          found && /release:/ {print $2; exit}
        ' /tmp/services.yml)
        RELEASE_NAME=${RELEASE_NAME:-$(echo "$SERVICE_NAME" | tr '_' '-')}

        DEPLOY_NAME=$(oc get deployment -n "$NAMESPACE" -l app.kubernetes.io/instance="$RELEASE_NAME" -o jsonpath='{.items[0].metadata.name}')
        if [ -z "$DEPLOY_NAME" ]; then
          echo "ERROR: Could not find deployment for release $RELEASE_NAME in $NAMESPACE"
          continue
        fi

        echo "▶ Restarting $DEPLOY_NAME in $NAMESPACE"
        oc rollout restart deployment/"$DEPLOY_NAME" -n "$NAMESPACE"
        oc rollout status deployment/"$DEPLOY_NAME" -n "$NAMESPACE" --timeout=120s
        echo "✅ $DEPLOY_NAME restarted"
      done <<< "$CHANGED_FILES"
