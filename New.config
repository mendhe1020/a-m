apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Release.Name }}-{{ .Values.configMap.nameSuffix }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{ include "Epay_Admin_Service.labels" . | nindent 4 }}
{{ if $.Values.configMap.additionalLabels }}
    {{ toYaml $.Values.configMap.additionalLabels | nindent 4 }}
{{ end }}
{{ if $.Values.configMap.annotations }}
  annotations:
    {{ toYaml $.Values.configMap.annotations | nindent 4 }}
{{ end }}
data:
  application.properties: |
    #{{ .Values.applicationProperties | nindent 4 }}
    server.servlet.context-path=/api/admin/v1
    server.port=9094
    spring.application.name=Epay_Admin_service
    

    ##cors.allowed.origins=https://dev.epay.sbi
    security.cors.allowed.origins=*
    spring.datasource.url=jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=epaydbscandev.sbiepay.sbi)(PORT=1524))(CONNECT_DATA= (SERVER=DEDICATED) (SERVICE_NAME=epaydbdev.sbiepay.sbi)))
    #spring.datasource.username=${DB_USERNAME}
    #spring.datasource.password=${DB_PASSWORD}
    spring.datasource.username=EPAYADMIN
    spring.datasource.password=April_2025
    spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
    spring.jpa.show-sql=true
    spring.jpa.hibernate.ddl-auto=none
    #spring.jpa.hibernate.ddl-auto=create
    
    #LIQUIBASE
    spring.liquibase.change-log=classpath:db/changelog/db.changelog-master.xml
    spring.liquibase.enabled=true
    spring.liquibase.drop-first=false
    logging.level.liquibase=INFO


    #GemFire settings -------------------------  

    spring.data.gemfire.pool.locators=gemfire-dev-locator.dev-cache-gemfire[10334]
    spring.data.gemfire.use-bean-factory-locator=false
    spring.data.gemfire.cache.server.port=40404
    spring.data.gemfire.logging.level=info

    spring.data.gemfire.security.ssl.keystore=/certs/keystore.p12
    spring.data.gemfire.security.ssl.keystore.password=HHy45TuP6CAjf6XMlxSE12CmyhEoklLv_JcYmy9RcBw=
    spring.data.gemfire.security.ssl.keystore.type=PKCS12
    spring.data.gemfire.security.ssl.truststore=/certs/truststore.p12
    spring.data.gemfire.security.ssl.truststore.password=HHy45TuP6CAjf6XMlxSE12CmyhEoklLv_JcYmy9RcBw=
    spring.data.gemfire.security.ssl.truststore.type=PKCS12

    #spring.data.gemfire.security.ssl.components=all
    spring.data.gemfire.security.ssl.enabled-components=all
    spring.data.gemfire.security.ssl.enable-endpoint-identification=false
    spring.data.gemfire.security.ssl.require-authentication=false
    spring.data.gemfire.security.ssl.web-require-authentication=false
    spring.data.gemfire.security.ssl.protocols=any
    spring.data.gemfire.security.ssl.ciphers=any

    #spring.data.gemfire.pdx.read-serialized=false
    #spring.data.gemfire.pdx.auto-serializable-classes=com.epay.admin.repository.cache.*
    logging.level.org.apache.geode=debug
    logging.level.org.springframework.data.gemfire=debug
    
    

    ##kafka 
    spring.kafka.bootstrap.servers=dev-kafka-cluster-kafka-bootstrap.dev-kafka.svc.cluster.local:9092
    spring.kafka.properties.security.protocol=PLAINTEXT
    spring.kafka.topic-prefix=cdc-oracle-gemfire.LOHITH_M
    spring.kafka.consumer.group-id=admin-consumers

    #health endpoint will not require the Origin header.
    security.cors.allowed.endpoints=/actuator/health, /actuator/health/readiness, /actuator/health/liveness
    security.whitelist.urls=/api/transaction/v1/actuator/health/**, /actuator/health/**


    management.endpoints.web.exposure.include=health, info
    management.endpoint.health.show-details=always
    management.endpoint.health.probes.enabled=true
    management.endpoint.health.livenessState.enabled=true
    management.endpoint.health.readinessState.enabled=true

    # UPI Configuration
    upi.pvt-key-pwd=Uat@Sbiepay
    upi.server-private-key-path= 0x1D883787-sec.asc
    upi.server-public-key-path= SBI0000000032588_UAT_1224_PublicKey.asc
    upi.cors-allowed-origins=https://dev.epay.sbi,http://localhost:9098
    upi.onboard-sub-merchant-url= https://uatupionline.sbi/merchant-web-war-6.0/upi/onBoardSubMerchant
    upi.pg-merchant-id=SBI0000000032588
    upi.business-name=MahaOnlineLimited 2.0
    upi.integration-type=WEBAPI
    upi.business-type=Govt, Govt Undertakings
    upi.request-url1=https://uat.epay.sbi/api/payments/v1/upi/sbi/callback
    upi.request-url2=https://uat.epay.sbi/api/payments/v1/upi/sbi/callback
    upi.ext-mid=1000003
    upi.ext-tid=
    upi.merchant-genre=ONLINE
    upi.onboarding-type=AGGREGATOR
    upi.txn-validation=1|2|3|5
    upi.me-whitelist=Y
    upi.me-concent-flag=N
    upi.split-tag=84

    # List of featureNotSupported entries
    upi.feature-not-supported[0].accTypeVal=05
    upi.feature-not-supported[0].accType=CREDIT
    upi.feature-not-supported[1].accTypeVal=06
    upi.feature-not-supported[1].accType=PPIWALLET
    upi.feature-not-supported[2].accTypeVal=31
    upi.feature-not-supported[2].accType=CREDITLINE
    
    logging.level.com.epay.sbi=INFO
    logging.level.org.apache.kafka=ERROR
    logging.level.org.apache.geode=ERROR
    logging.level.com.epay.admin=INFO
    logging.level.org.springframework=ERROR


