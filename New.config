apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Release.Name }}-{{ .Values.configMap.nameSuffix }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{ include "Epay_Payment_Service.labels" . | nindent 4 }}
  {{- if $.Values.configMap.additionalLabels }}
    {{ toYaml $.Values.configMap.additionalLabels | nindent 4 }}
  {{- end }}
  {{- if $.Values.configMap.annotations }}
  annotations:
    {{ toYaml $.Values.configMap.annotations | nindent 4 }}
  {{- end }}

data:
  application.yaml: |
    # Application identity
    spring.application.name: epay_payment_service

    # Server / servlet container
    server.port: 9093
    server.servlet.context-path: /api/payments/v1/

    # JPA / Hibernate
    spring.jpa.show-sql: true
    spring.jpa.properties.hibernate.show_sql: true
    spring.jpa.properties.hibernate.format_sql: true

    # Spring
    spring.web.resources.static-locations: classpath:/,file:/non-existent-folder

    # SSL certificate configuration
    spring.ssl.bundle.pem.bank.truststore.certificate: file:/etc/epay/certs/trust/trust-bundle.pem
    spring.http.reactiveclient.ssl.bundle: bank

  trust-bundle.pem: |
    # cert-id: merchant-sbiuat-bank
    # subject: merchant.sbiuat.bank.in
    # added: 2026-08-09

    -----BEGIN CERTIFICATE-----
    YOUR_MERCHANT_CERTIFICATE_HERE
    -----END CERTIFICATE-----

    # cert-id: sms
    # subject: YOUR_SMS_CERTIFICATE_SUBJECT
    # added: 2026-08-09

    -----BEGIN CERTIFICATE-----
    YOUR_SMS_CERTIFICATE_HERE
    -----END CERTIFICATE-----

    # cert-id: mobikwik-test1
    # subject: test1.mobikwik.com
    # added: 2026-08-09

    -----BEGIN CERTIFICATE-----
    YOUR_TEST1_CERTIFICATE_HERE
    -----END CERTIFICATE-----

    # cert-id: mobikwik-test2
    # subject: test2.mobikwik.com
    # added: 2026-08-09

    -----BEGIN CERTIFICATE-----
    YOUR_TEST2_CERTIFICATE_HERE
    -----END CERTIFICATE-----

    # cert-id: mobikwik-test3
    # subject: test3.mobikwik.com
    # added: 2026-08-09

    -----BEGIN CERTIFICATE-----
    YOUR_TEST3_CERTIFICATE_HERE
    -----END CERTIFICATE-----

  cert-inventory.yaml: |
    certificates:
      - cert_id: merchant-sbiuat-bank
        subject_cn: "merchant.sbiuat.bank.in"
        purpose: "outbound bank gateway TLS"
        added_by: "<your-name>"
        added_date: "2026-08-09"
        source: "<certificate source>"

      - cert_id: sms
        subject_cn: "<actual-SMS-CN>"
        purpose: "SMS gateway TLS"
        added_by: "<your-name>"
        added_date: "2026-08-09"
        source: "<certificate source>"

      - cert_id: mobikwik-test1
        subject_cn: "test1.mobikwik.com"
        purpose: "Mobikwik TLS"
        added_by: "<your-name>"
        added_date: "2026-08-09"
        source: "<certificate source>"

      - cert_id: mobikwik-test2
        subject_cn: "test2.mobikwik.com"
        purpose: "Mobikwik TLS"
        added_by: "<your-name>"
        added_date: "2026-08-09"
        source: "<certificate source>"

      - cert_id: mobikwik-test3
        subject_cn: "test3.mobikwik.com"
        purpose: "Mobikwik TLS"
        added_by: "<your-name>"
        added_date: "2026-08-09"
        source: "<certificate source>"
