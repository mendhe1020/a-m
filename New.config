# #COPY ./merchant.sbiuat.bank.in.crt /etc/pki/tls/certs/
# #COPY ./merchant.sbiuat.bank.in.crt /etc/pki/ca-trust/source/anchors/
# COPY /build/libs/epay_payment_service-${VERSION}.jar .
# ENTRYPOINT sh -c 'java -jar "epay_payment_service-$VERSION.jar"'
# #USER 0
# #RUN cd /usr/lib/jvm/java-21/bin
# #RUN yes | keytool -import -trustcacerts -file /tmp/sms.cer -keystore /usr/lib/jvm/java-21/lib/security/cacerts -alias DEV_EPAY_SMS #-storepass changeit
ARG BASE_IMAGE_DEV_ENV
FROM ${BASE_IMAGE_DEV_ENV}
ARG ENV
ARG VERSION
ENV ENV=$ENV
ENV VERSION=$VERSION
COPY ./sms.cer  /tmp
RUN ls -lrth /tmp/
COPY ./merchant.sbiuat.bank.in.crt /etc/pki/tls/certs/
COPY ./merchant.sbiuat.bank.in.crt /etc/pki/ca-trust/source/anchors/
COPY ./test1.mobikwik.com.crt /etc/pki/tls/certs/
COPY ./test1.mobikwik.com.crt /etc/pki/ca-trust/source/anchors/
COPY ./test2.mobikwik.com.crt /etc/pki/tls/certs/
COPY ./test2.mobikwik.com.crt /etc/pki/ca-trust/source/anchors/
COPY ./test3.mobikwik.com.crt /etc/pki/tls/certs/
COPY ./test3.mobikwik.com.crt /etc/pki/ca-trust/source/anchors/
COPY /build/libs/epay_payment_service-${VERSION}.jar .
ENTRYPOINT sh -c 'java -jar "epay_payment_service-$VERSION.jar"'
USER 0
ENTRYPOINT sh -c 'java -jar "epay_payment_service-$VERSION.jar"'
RUN cd /usr/lib/jvm/java-21/bin
RUN yes | keytool -import -trustcacerts -file /tmp/sms.cer -keystore /usr/lib/jvm/java-21/lib/security/cacerts -alias DEV_EPAY_SMS -storepass changeit
COPY ./epaycert.cer  /tmp
USER root
RUN yes | keytool -import -trustcacerts -file /tmp/epaycert.cer -keystore /usr/lib/jvm/java-21/lib/security/cacerts -alias S3_EPAY_CERT -storepass changeit
RUN update-ca-trust enable
RUN update-ca-trust extract
RUN update-ca-trust




