# Deployment definition
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "Epay_Payment_Service.fullname" . }}
  labels:
    {{- include "Epay_Payment_Service.labels" . | nindent 4 }}
spec:
  {{- if not .Values.autoscaling.enabled }}
  replicas: {{ .Values.replicaCount }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "Epay_Payment_Service.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      annotations:
        checksum/configmap: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
        {{- with .Values.podAnnotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
      labels:
        {{- include "Epay_Payment_Service.labels" . | nindent 8 }}
        {{- with .Values.podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
    spec:
      {{- with .Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      serviceAccountName: {{ include "Epay_Payment_Service.serviceAccountName" . }}
      securityContext:
        {{- toYaml .Values.podSecurityContext | nindent 8 }} 
###############################
      {{- if .Values.initContainer.enabled }}
      #Init-container for trust-store
      initContainers:
        - name: import-certs
          image: {{ .Values.initContainer.image }}
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            #runAsNonRoot: true
            #runAsUser: 0
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -euo pipefail

              echo "[INFO] Preparing shared cacerts volume..."
              for C in \
                "$JAVA_HOME/lib/security/cacerts" \
                "/usr/lib/jvm/java-21/lib/security/cacerts" \
                "/etc/pki/java/cacerts"; do
                if [ -r "$C" ]; then
                  echo "[INFO] Using truststore at $C"
                  mkdir -p /cacerts/data
                  cp "$C" /cacerts/data/cacerts
                  chmod 660 /cacerts/data/cacerts
                  break
                fi
              done
              
              echo "[INFO] Importing custom certificates..."
              for f in /etc/custom-certs-payment/*.crt /etc/custom-certs-payment/*.cer /certs/*.crt /certs/*.cer; do
                [ -e "$f" ] || continue
                base="$(basename "$f")"
                alias="$(echo "$base" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')"
                echo "[INFO] Importing $base as alias $alias"
                keytool -import -trustcacerts -file "$f" \
                  -alias "$alias" \
                  -keystore /cacerts/data/cacerts \
                  -storepass {{ .Values.initContainer.truststorePassword }} -noprompt || true
              done
              
          volumeMounts:
            # - name: dcms-txn-cert
            #   mountPath: /certs
            - name: custom-certs-payment
              mountPath: /etc/custom-certs-payment
            - name: cacerts
              mountPath: /cacerts            
      {{- end }}
#############################################
      containers:
        - name: {{ .Chart.Name }}
          securityContext:
            {{- toYaml .Values.securityContext | nindent 12 }}
          image: "{{ tpl .Values.image.repository $ }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          ports:
            - name: http
              containerPort: {{ .Values.service.port }}
              protocol: TCP
          env:
          - name: JAVA_TOOL_OPTIONS
            value: "-Djavax.net.ssl.trustStore=/cacerts/data/cacerts -Djavax.net.ssl.trustStorePassword=changeit"
          - name: SPRING_CONFIG_LOCATION
            value: file:/opt/gradle/
          - name: DB_USERNAME
            valueFrom:
              secretKeyRef:
                name: my-secrets-payment-service-secret
                key: DB_USERNAME
          - name: DB_PASSWORD
            valueFrom:
              secretKeyRef:
                name: my-secrets-payment-service-secret
                key: DB_PASSWORD
          {{- if .Values.readinessProbe.enabled }}
          readinessProbe:
            httpGet:
              # path: {{ .Values.prefixName }}/actuator/health
              # port: {{ .Values.service.port }}
              path: {{ .Values.readinessProbe.httpGet.path }}
              port: {{ .Values.readinessProbe.httpGet.port }}
            initialDelaySeconds: 60
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          {{- end }}
          {{- if .Values.livenessProbe.enabled }}
          livenessProbe:
            httpGet:
              # path: {{ .Values.prefixName }}/actuator/health
              # port: {{ .Values.service.port }}
              path: {{ .Values.livenessProbe.httpGet.path }}
              port: {{ .Values.livenessProbe.httpGet.port }}
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 10
            failureThreshold: 6
            successThreshold: 1
          {{- end }}                
          volumeMounts:
            - name: config
              mountPath: "/opt/gradle"
            - name: payment-upivpaqr-cert
              readOnly: true
              mountPath: /certs 
            # - name: dcms-txn-cert
            #   readOnly: true
            #   mountPath: /certs
            ###
            {{- if .Values.customCertsPayment.enabled }}
            - name: custom-certs-payment
              mountPath: {{ .Values.customCertsPayment.mountPaths }}
              readOnly: true
            {{- end }}
            - name: cacerts
              mountPath: /cacerts
              readOnly: true
            ###
      volumes:
        - name: config
          configMap:
            name: payment-config
        - name: payment-upivpaqr-cert
          secret:
            secretName: payment-upivpaqr
            defaultMode: 444
        # - name: dcms-txn-cert
        #   secret:
        #     secretName: eiscert
        #     defaultMode: 420
        ###
        {{- if .Values.customCertsPayment.enabled }}
        - name: custom-certs-payment
          secret:
            secretName: {{ .Values.customCertsPayment.secretName }} 
        {{- end }}
        - name: cacerts
          emptyDir: {}
        ######################################################################################################################################

##FROM registry.dev.sbiepay.sbi:8443/ubi9/openjdk-21:1.23-6.1755674728
#FROM registry.dev.sbiepay.sbi:8443/ubi9/openjdk-21:1.24
