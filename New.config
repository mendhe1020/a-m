include:
  - local: 'config/services.yaml'

# ============================================================
# Pipeline workflow
# ============================================================

workflow:
  auto_cancel:
    on_new_commit: "none"

stages:
  - publish
  - validate
  - deploy
  - verify


# ============================================================
# Global variables
# ============================================================

variables:

  DEV_CLUSTER: "https://api.dev.sbiepay.sbi:6443"

  PREPROD_CLUSTER: "https://api.preprod.epay.sbi:6443"

  PREPROD_DC_CLUSTER: "https://api.dcpreprod.epay.sbi:6443"

  PROD_DR_CLUSTER: "https://api.dr.prod.epay.sbi:6443"

  PROD_DC_CLUSTER: "https://api.dc.prod.epay.sbi:6443"

  HELM_HISTORY_MAX: "10"

  DEPLOYMENT_TIMEOUT: "15m"

  # ----------------------------------------------------------
  # Helm chart repository
  #
  # IMPORTANT:
  # Replace this with the actual GitLab repository URL
  # according to your SBI GitLab setup.
  # ----------------------------------------------------------

  EPAY_HELM_CHARTS_REPO: "https://gitlab.sbi/itepaypg-sbiepay2/infra/devops/epay-helm-charts.git"

  GIT_STRATEGY: clone

  # Required because we need Git tags from epay-helm-charts
  GIT_DEPTH: "0"


# ============================================================
# Common validation
# ============================================================

.validate_inputs:

  before_script:

    - |
      set -eo pipefail

      if [ -z "$SERVICE_NAME" ]; then
        echo "ERROR: SERVICE_NAME is required"
        exit 1
      fi

      if [ -z "$ENV" ]; then
        echo "ERROR: ENV is required"
        exit 1
      fi

      if [[ ! "$ENV" =~ ^(dev|sit|uat|int|perf|pre-prod|pre-prod-dc|prod-dr|prod-dc)$ ]]; then
        echo "ERROR: Invalid ENV '$ENV'"
        exit 1
      fi

      echo "======================================"
      echo "SERVICE_NAME = $SERVICE_NAME"
      echo "ENV          = $ENV"
      echo "======================================"


# ============================================================
# PUBLISH
#
# Existing application image-tag update mechanism remains
# unchanged.
# ============================================================

# Your existing update-tag job can remain here.
#
# Example:
#
# update-tag:
#   extends:
#     - .update_tag
#   rules:
#     - if: '$CI_PIPELINE_SOURCE == "pipeline"'


# ============================================================
# VALIDATE SERVICE
# ============================================================

validate_service:

  stage: validate

  image:
    name: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/custom-ci/rhelgit-oc-helm:1.0

  tags:
    - deploy_runner

  script:

    - |
      set -eo pipefail

      echo "======================================"
      echo "Starting deployment configuration validation"
      echo "======================================"

      # --------------------------------------------------------
      # SERVICE / ENV
      # --------------------------------------------------------

      if [ -z "$SERVICE_NAME" ]; then
        echo "ERROR: SERVICE_NAME is required"
        exit 1
      fi

      if [ -z "$ENV" ]; then
        echo "ERROR: ENV is required"
        exit 1
      fi

      echo "SERVICE_NAME=$SERVICE_NAME"
      echo "ENV=$ENV"


      # --------------------------------------------------------
      # SERVICES CONFIG
      # --------------------------------------------------------

      echo "$SERVICES_CONFIG" > /tmp/services.yml


      # --------------------------------------------------------
      # NEW DEPLOYMENT-CONFIG STRUCTURE
      #
      # Example:
      #
      # clusters/
      # └── nonprod/
      #     └── dev/
      #         └── admin-service/
      #             └── values.yaml
      #
      # IMPORTANT:
      # Change this path if your actual directory structure
      # is different.
      # --------------------------------------------------------

      SVC_VALUES="clusters/nonprod/${ENV}/${SERVICE_NAME}/values.yaml"

      echo "Service values file:"
      echo "$SVC_VALUES"


      # --------------------------------------------------------
      # Check service values file
      # --------------------------------------------------------

      if [ ! -f "$SVC_VALUES" ]; then

        echo "======================================"
        echo "ERROR: Service values file not found"
        echo "PATH: $SVC_VALUES"
        echo "======================================"

        echo "Available files:"
        find clusters -type f -name "values.yaml" 2>/dev/null || true

        exit 1

      fi


      # --------------------------------------------------------
      # RELEASE NAME
      # --------------------------------------------------------

      RELEASE_NAME=$(awk -v svc="$SERVICE_NAME" '
        $0 ~ "name: "svc {found=1}
        found && /release:/ {print $2; exit}
      ' /tmp/services.yml)

      RELEASE_NAME=${RELEASE_NAME:-$(echo "$SERVICE_NAME" | tr '_' '-')}


      # --------------------------------------------------------
      # NAMESPACE
      # --------------------------------------------------------

      NAMESPACE=$(awk -v svc="$SERVICE_NAME" '
        /namespace:/ {ns=$3}
        $0 ~ "name: "svc {print ns; exit}
      ' /tmp/services.yml)

      NAMESPACE="${ENV}-${NAMESPACE}"


      # --------------------------------------------------------
      # READ CHART VERSION
      # --------------------------------------------------------

      CHART_VERSION=$(yq e '.chartVersion' "$SVC_VALUES")


      # --------------------------------------------------------
      # READ SERVICE TYPE
      # --------------------------------------------------------

      TYPE=$(yq e '.type' "$SVC_VALUES")


      # --------------------------------------------------------
      # READ IMAGE TAG
      # --------------------------------------------------------

      IMAGE_TAG=$(yq e '.image.tag' "$SVC_VALUES")


      # --------------------------------------------------------
      # Validate chartVersion
      # --------------------------------------------------------

      if [ -z "$CHART_VERSION" ] || [ "$CHART_VERSION" = "null" ]; then

        echo "======================================"
        echo "ERROR: chartVersion is missing"
        echo "FILE: $SVC_VALUES"
        echo "======================================"

        exit 1

      fi


      # --------------------------------------------------------
      # Validate service type
      # --------------------------------------------------------

      if [ -z "$TYPE" ] || [ "$TYPE" = "null" ]; then

        echo "======================================"
        echo "ERROR: type is missing"
        echo "FILE: $SVC_VALUES"
        echo "======================================"

        exit 1

      fi


      # --------------------------------------------------------
      # Validate service type
      # --------------------------------------------------------

      case "$TYPE" in

        java)
          echo "Service type: JAVA"
          ;;

        frontend)
          echo "Service type: FRONTEND"
          ;;

        *)
          echo "ERROR: Unsupported service type '$TYPE'"
          echo "Supported types: java, frontend"
          exit 1
          ;;

      esac


      # --------------------------------------------------------
      # Validate image tag
      # --------------------------------------------------------

      if [ -z "$IMAGE_TAG" ] || [ "$IMAGE_TAG" = "null" ]; then

        echo "======================================"
        echo "ERROR: image.tag is missing"
        echo "FILE: $SVC_VALUES"
        echo "======================================"

        exit 1

      fi


      # --------------------------------------------------------
      # Print deployment information
      # --------------------------------------------------------

      echo ""
      echo "======================================"
      echo "DEPLOYMENT INFORMATION"
      echo "======================================"
      echo "SERVICE_NAME  = $SERVICE_NAME"
      echo "ENV           = $ENV"
      echo "RELEASE_NAME  = $RELEASE_NAME"
      echo "NAMESPACE     = $NAMESPACE"
      echo "CHART_VERSION = $CHART_VERSION"
      echo "TYPE          = $TYPE"
      echo "IMAGE_TAG     = $IMAGE_TAG"
      echo "SVC_VALUES    = $SVC_VALUES"
      echo "======================================"


      # --------------------------------------------------------
      # Git authentication
      #
      # Required to access epay-helm-charts.
      #
      # Use the existing approved GitLab deploy token.
      # --------------------------------------------------------

      git config --global http.sslVerify false

      git config --global --add safe.directory '*'


      # --------------------------------------------------------
      # Clone epay-helm-charts repository
      # --------------------------------------------------------

      rm -rf chart-src

      echo "Cloning epay-helm-charts..."

      git clone "$EPAY_HELM_CHARTS_REPO" chart-src


      # --------------------------------------------------------
      # Checkout exact master-chart version
      #
      # Example:
      #
      # master-chart/v1.0.0
      # --------------------------------------------------------

      cd chart-src

      echo "Checking out:"
      echo "master-chart/v${CHART_VERSION}"

      git checkout "master-chart/v${CHART_VERSION}"

      cd ..


      # --------------------------------------------------------
      # Verify chart exists
      # --------------------------------------------------------

      if [ ! -d "chart-src/master-chart" ]; then

        echo "======================================"
        echo "ERROR: master-chart not found"
        echo "Chart version: $CHART_VERSION"
        echo "======================================"

        exit 1

      fi


      # --------------------------------------------------------
      # Verify selected chart version
      # --------------------------------------------------------

      echo ""
      echo "======================================"
      echo "Using Helm Chart"
      echo "======================================"
      echo "master-chart/v${CHART_VERSION}"
      echo "======================================"


      # --------------------------------------------------------
      # Helm lint
      # --------------------------------------------------------

      echo "Running Helm lint..."

      helm lint \
        chart-src/master-chart \
        -f "chart-src/master-chart/values-${TYPE}.yaml" \
        -f "$SVC_VALUES"


      # --------------------------------------------------------
      # Helm template
      # --------------------------------------------------------

      echo "Running Helm template..."

      helm template \
        "$RELEASE_NAME" \
        chart-src/master-chart \
        -f "chart-src/master-chart/values-${TYPE}.yaml" \
        -f "$SVC_VALUES"


      echo ""
      echo "======================================"
      echo "HELM VALIDATION PASSED"
      echo "======================================"


      # --------------------------------------------------------
      # Export variables for next stage
      # --------------------------------------------------------

      echo "SERVICE_NAME=$SERVICE_NAME" >> build.env

      echo "ENV=$ENV" >> build.env

      echo "RELEASE_NAME=$RELEASE_NAME" >> build.env

      echo "NAMESPACE=$NAMESPACE" >> build.env

      echo "CHART_VERSION=$CHART_VERSION" >> build.env

      echo "TYPE=$TYPE" >> build.env

      echo "IMAGE_TAG=$IMAGE_TAG" >> build.env

      echo "SVC_VALUES=$SVC_VALUES" >> build.env

      echo "EPAY_HELM_CHARTS_REPO=$EPAY_HELM_CHARTS_REPO" >> build.env


  artifacts:

    reports:
      dotenv: build.env

    expire_in: 1 hour


# ============================================================
# HELM DEPLOY
# ============================================================

helm_deploy:

  stage: deploy

  image:
    name: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/custom-ci/rhelgit-oc-helm:1.0

  tags:
    - deploy_runner

  dependencies:
    - validate_service

  needs:

    - job: validate_service
      artifacts: true

  extends:
    - .validate_inputs

  script:

    - |
      set -eo pipefail

      echo "======================================"
      echo "STARTING HELM DEPLOYMENT"
      echo "======================================"

      echo "SERVICE_NAME  = $SERVICE_NAME"
      echo "ENV           = $ENV"
      echo "RELEASE_NAME  = $RELEASE_NAME"
      echo "NAMESPACE     = $NAMESPACE"
      echo "CHART_VERSION = $CHART_VERSION"
      echo "TYPE          = $TYPE"
      echo "IMAGE_TAG     = $IMAGE_TAG"

      echo "======================================"


      # --------------------------------------------------------
      # Select OpenShift cluster
      # --------------------------------------------------------

      case "$ENV" in

        dev|sit|uat|int)

          CLUSTER="$DEV_CLUSTER"
          TOKEN="$OCP_TOKEN_DEV_CLUSTER"

          ;;

        pre-prod|perf)

          CLUSTER="$PREPROD_CLUSTER"
          TOKEN="$OCP_TOKEN_PREPROD_DR"

          ;;

        pre-prod-dc)

          CLUSTER="$PREPROD_DC_CLUSTER"
          TOKEN="$OCP_TOKEN_PREPROD_DC"

          ;;

        prod-dr)

          CLUSTER="$PROD_DR_CLUSTER"
          TOKEN="$OCP_TOKEN_PROD_DR"

          ;;

        prod-dc)

          CLUSTER="$PROD_DC_CLUSTER"
          TOKEN="$OCP_TOKEN_PROD_DC"

          ;;

        *)

          echo "ERROR: Unsupported ENV=$ENV"
          exit 1

          ;;

      esac


      # --------------------------------------------------------
      # Login to OpenShift
      # --------------------------------------------------------

      echo "Logging into OpenShift..."

      oc login "$CLUSTER" \
        --token="$TOKEN" \
        --insecure-skip-tls-verify


      # --------------------------------------------------------
      # Clone exact Helm chart version
      #
      # IMPORTANT:
      # We intentionally fetch the same chart version that
      # validation used.
      # --------------------------------------------------------

      rm -rf chart-src

      git config --global http.sslVerify false

      git config --global --add safe.directory '*'


      echo "Cloning epay-helm-charts..."

      git clone "$EPAY_HELM_CHARTS_REPO" chart-src


      cd chart-src

      echo "Checking out master-chart/v${CHART_VERSION}"

      git checkout "master-chart/v${CHART_VERSION}"

      cd ..


      # --------------------------------------------------------
      # Verify chart exists
      # --------------------------------------------------------

      if [ ! -d "chart-src/master-chart" ]; then

        echo "ERROR: master-chart not found"

        echo "Expected:"
        echo "master-chart/v${CHART_VERSION}"

        exit 1

      fi


      # --------------------------------------------------------
      # Helm Diff
      # --------------------------------------------------------

      echo ""
      echo "======================================"
      echo "HELM DIFF"
      echo "======================================"

      helm diff upgrade \
        "$RELEASE_NAME" \
        chart-src/master-chart \
        -n "$NAMESPACE" \
        -f "chart-src/master-chart/values-${TYPE}.yaml" \
        -f "$SVC_VALUES"


      # --------------------------------------------------------
      # Helm Deployment
      # --------------------------------------------------------

      echo ""
      echo "======================================"
      echo "HELM UPGRADE"
      echo "======================================"

      helm upgrade --install \
        "$RELEASE_NAME" \
        chart-src/master-chart \
        -n "$NAMESPACE" \
        --create-namespace \
        -f "chart-src/master-chart/values-${TYPE}.yaml" \
        -f "$SVC_VALUES" \
        --atomic \
        --timeout "$DEPLOYMENT_TIMEOUT" \
        --history-max="$HELM_HISTORY_MAX" \
        --wait


      echo ""
      echo "======================================"
      echo "HELM DEPLOYMENT COMPLETED"
      echo "======================================"

      echo "Service      : $SERVICE_NAME"
      echo "Environment  : $ENV"
      echo "Namespace    : $NAMESPACE"
      echo "Chart        : master-chart/v${CHART_VERSION}"
      echo "Image Tag    : $IMAGE_TAG"
      echo "Release      : $RELEASE_NAME"

      echo "======================================"


# ============================================================
# VERIFY
# ============================================================

verify_deployment:

  stage: verify

  image:
    name: artifactory.jfrog.sbi:443/itepaypg-sbiepay2-docker-local/custom-ci/rhelgit-oc-helm:1.0

  tags:
    - deploy_runner

  dependencies:
    - validate_service

  needs:

    - job: validate_service
      artifacts: true

    - job: helm_deploy
      artifacts: false

  extends:
    - .validate_inputs

  script:

    - |
      set -eo pipefail

      echo "======================================"
      echo "VERIFYING OPENSHIFT DEPLOYMENT"
      echo "======================================"

      echo "SERVICE_NAME = $SERVICE_NAME"
      echo "ENV          = $ENV"
      echo "RELEASE_NAME = $RELEASE_NAME"
      echo "NAMESPACE    = $NAMESPACE"
      echo "CHART_VERSION= $CHART_VERSION"


      # --------------------------------------------------------
      # Select cluster
      # --------------------------------------------------------

      case "$ENV" in

        dev|sit|uat|int)

          CLUSTER="$DEV_CLUSTER"
          TOKEN="$OCP_TOKEN_DEV_CLUSTER"

          ;;

        pre-prod|perf)

          CLUSTER="$PREPROD_CLUSTER"
          TOKEN="$OCP_TOKEN_PREPROD_DR"

          ;;

        pre-prod-dc)

          CLUSTER="$PREPROD_DC_CLUSTER"
          TOKEN="$OCP_TOKEN_PREPROD_DC"

          ;;

        prod-dr)

          CLUSTER="$PROD_DR_CLUSTER"
          TOKEN="$OCP_TOKEN_PROD_DR"

          ;;

        prod-dc)

          CLUSTER="$PROD_DC_CLUSTER"
          TOKEN="$OCP_TOKEN_PROD_DC"

          ;;

        *)

          echo "ERROR: Unsupported ENV=$ENV"
          exit 1

          ;;

      esac


      # --------------------------------------------------------
      # OpenShift login
      # --------------------------------------------------------

      oc login "$CLUSTER" \
        --token="$TOKEN" \
        --insecure-skip-tls-verify


      # --------------------------------------------------------
      # Deployment status
      # --------------------------------------------------------

      echo ""
      echo "Deployment status:"

      oc rollout status \
        deployment/"$RELEASE_NAME" \
        -n "$NAMESPACE" \
        --timeout="$DEPLOYMENT_TIMEOUT"


      # --------------------------------------------------------
      # Pods
      # --------------------------------------------------------

      echo ""
      echo "Pods:"

      oc get pods \
        -n "$NAMESPACE" \
        -l "app.kubernetes.io/instance=$RELEASE_NAME" \
        -o wide


      # --------------------------------------------------------
      # Service
      # --------------------------------------------------------

      echo ""
      echo "Services:"

      oc get svc \
        -n "$NAMESPACE"


      # --------------------------------------------------------
      # ConfigMaps
      # --------------------------------------------------------

      echo ""
      echo "ConfigMaps:"

      oc get configmap \
        -n "$NAMESPACE"


      # --------------------------------------------------------
      # Helm release
      # --------------------------------------------------------

      echo ""
      echo "Helm release:"

      helm list \
        -n "$NAMESPACE" \
        --filter "^${RELEASE_NAME}$"


      echo ""
      echo "======================================"
      echo "DEPLOYMENT VERIFICATION PASSED"
      echo "======================================"




