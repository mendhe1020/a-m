apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Release.Name }}-{{ .Values.configMap.nameSuffix }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{ include "Epay_Admin_Service.labels" . | nindent 4 }}
{{- if $.Values.configMap.additionalLabels }}
    {{ toYaml $.Values.configMap.additionalLabels | nindent 4 }}
{{- end }}
{{- if $.Values.configMap.annotations }}
  annotations:
    {{ toYaml $.Values.configMap.annotations | nindent 4 }}
{{- end }}

data:
  application.yml: |
    spring:
      datasource:
        url: jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=epaydbscandev.sbiepay.sbi)(PORT=1524))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=epaydbdev.sbiepay.sbi)))
        username: EPAYADMIN
        password: April_2025

      jpa:
        hibernate:
          ddl-auto: none

      kafka:
        bootstrap-servers: dev-kafka-cluster-kafka-bootstrap.dev-kafka.svc.cluster.local:9092
        topic-prefix: cdc-oracle-gemfire.LOHITH_M
        properties:
          security:
            protocol: PLAINTEXT
        consumer:
          group-id: admin-consumers

    security:
      cors:
        allowed-origins: "*"
      whitelist:
        urls: /api/transaction/v1/actuator/health/**,/actuator/health/**

    upi:
      pvt-key-pwd: Uat@Sbiepay
      server-private-key-path: 0x1D883787-sec.asc
      server-public-key-path: SBI0000000032588_UAT_1224_PublicKey.asc
      cors-allowed-origins: https://dev.epay.sbi,http://localhost:9098
      onboard-sub-merchant-url: https://uatupionline.sbi/merchant-web-war-6.0/upi/onBoardSubMerchant
      pg-merchant-id: SBI0000000032588
      business-name: "MahaOnlineLimited 2.0"
      integration-type: WEBAPI
      business-type: "Govt, Govt Undertakings"
      request-url1: https://uat.epay.sbi/api/payments/v1/upi/sbi/callback
      request-url2: https://uat.epay.sbi/api/payments/v1/upi/sbi/callback
      ext-mid: "1000003"
      ext-tid: ""
      merchant-genre: ONLINE
      onboarding-type: AGGREGATOR
      txn-validation: "1|2|3|5"
      me-whitelist: "Y"
      me-concent-flag: "N"
      split-tag: "84"
      feature-not-supported:
        - accTypeVal: "05"
          accType: CREDIT
        - accTypeVal: "06"
          accType: PPIWALLET
        - accTypeVal: "31"
          accType: CREDITLINE

    logging:
      level:
        liquibase: INFO
        com.epay.sbi: INFO
        org.apache.kafka: ERROR
        com.epay.admin: INFO
        org.springframework: ERROR
