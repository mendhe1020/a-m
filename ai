server:
  port: 9098
  servlet:
    context-path: /api/admin/v1
spring:
  application:
    name: Epay_Admin_service
  profiles:
    active: local
  datasource:
    driver-class-name: oracle.jdbc.OracleDriver
  jpa:
    properties:
      hibernate:
        show_sql: true
    show-sql: true
  # Liquibase Properties
  liquibase:
    change-log: classpath:db/changelog/db.changelog-master.xml
    enabled: false
    drop-first: false
external:
  api:
    merchant:
      services:
        base:
          path: http://localhost:9093/merchant/v1
security:
  cors:
    allowed:
      #health endpoint will not require the Origin header.
      endpoints: /actuator/health, /actuator/health/readiness, /actuator/health/liveness
management:
  endpoints.web.exposure.include=: health, info
  endpoint.health:
    show-details: always
    probes.enabled: true
    livenessState.enabled: true
    readinessState.enabled: true
